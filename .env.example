# Server
PORT=3002
NODE_ENV=development
CORS_ORIGIN=http://localhost:5175
SESSION_SECRET=sprink-dev-secret

# Database (empty = SQLite auto-select)
DATABASE_URL=
SQLITE_PATH=./data/sprink-dev.db
DB_POOL_MIN=2
DB_POOL_MAX=10
DATABASE_SSL=true

# Redis (PostgreSQL mode only)
REDIS_URL=redis://localhost:6379

# TRPGO OIDC
TRPGO_OIDC_ISSUER=http://localhost:3000
TRPGO_OIDC_CLIENT_ID=sprink
TRPGO_OIDC_CLIENT_SECRET=
TRPGO_OIDC_REDIRECT_URI=http://localhost:3002/api/v1/auth/callback/trpgo
